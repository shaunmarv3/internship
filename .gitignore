# --- data / weights / caches ---
# anchored to repo root with a leading slash so these do NOT also match src/data/ etc.
/checkpoints/
/backend/data/
/smoke_data/
*.pt
*.pth
*.ckpt
wandb/
__pycache__/
*.pyc
.pytest_cache/
.env
*.egg-info/
dist/
.ipynb_checkpoints/
*.7z
*.zip
*.tif
*.tiff

# --- /data: everything is local except two small published slices ---
# (the full HRSID + Zenodo sets are public; download_vessel_data.py / the oil notebook fetch them)
/data/*
!/data/oil/
!/data/vessels/
/data/vessels/*
!/data/vessels/hrsid_sample/
# re-allow the 4 oil scenes, which the global *.tif rule above would otherwise swallow
!/data/oil/*.tif

# --- logs ---
*.log

# --- LaTeX / paper sources (kept locally, not published) ---
/paper/
/paper_ieee_access/
/amazon_wildfire_detection/
/internship/
/ppt/
/pptimg/
*.docx
*.pptx
*.aux
*.bbl
*.blg
*.out
*.synctex.gz

# --- retired / local-only code ---
/app/
/docs/

# --- working notes: only README.md is published ---
/*.md
!/README.md

# --- agent scaffolding ---
.agents/
.claude/
CLAUDE.md
AGENTS.md
claude.md

# --- scratch scene renders at repo root ---
/*.png
/*.jpg
